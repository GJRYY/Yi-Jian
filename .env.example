# 复制本文件为 .env 后按需填写（.env 已被 .gitignore 忽略）

# 后端监听端口
PORT=3000

# 本地数据目录（商品资料和上传图片会保存在这里）
DATA_DIR=./data

# 图片上传大小上限（字节），默认 5MB
MAX_UPLOAD_BYTES=5242880

# ---- 可选：模型服务配置（第二阶段接入，不填也能正常运行）----
# 使用 OpenAI 风格兼容接口，例如 DeepSeek 的 https://api.deepseek.com
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

